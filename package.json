{
  "name": "hunter-pi",
  "version": "0.0.0",
  "private": true,
  "description": "Hunter Pi engineering workspace",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11.0.0 <12"
  },
  "packageManager": "npm@11.9.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json --clean && tsc -b tsconfig.build.json --pretty false",
    "clean-install-smoke": "node scripts/clean-install-smoke.mjs",
    "doctor": "node tools/doctor.ts --json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "package-smoke": "npm run build && node scripts/package-smoke.mjs",
    "strict:check": "node scripts/strict-compiler-smoke.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "verify": "npm run lint && npm run typecheck && npm test && npm run strict:check && npm run build && npm run format:check && npm run package-smoke && npm run clean-install-smoke"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "eslint": "10.8.0",
    "globals": "17.9.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
}
