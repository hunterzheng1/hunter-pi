{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "checkJs": true,
    "noEmit": true,
    "paths": {
      "@hunter-pi/cli": ["./apps/cli/src/index.ts"],
      "@hunter-pi/domain": ["./packages/domain/src/index.ts"],
      "@hunter-pi/evidence": ["./packages/evidence/src/index.ts"],
      "@hunter-pi/engine-contracts": ["./packages/engine-contracts/src/index.ts"],
      "@hunter-pi/pi-host": ["./packages/pi-host/src/index.ts"],
      "@hunter-pi/testkit": ["./packages/testkit/src/index.ts"],
      "@hunter-pi/workflow-kernel": ["./packages/workflow-kernel/src/index.ts"]
    },
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "apps/*/src/**/*.ts",
    "packages/*/src/**/*.ts",
    "scripts/**/*.mjs",
    "test/**/*.ts",
    "tools/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": ["test/fixtures/**"]
}
